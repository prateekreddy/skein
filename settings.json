{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" notify-blocked",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" notify-waiting",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" notify-ignore",
            "type": "command"
          }
        ],
        "matcher": "auth_success|elicitation_complete|elicitation_response|agent_completed"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" notify-auto",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-session.sh\" ask",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input"
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" compacted",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-task.sh\"",
            "type": "command"
          }
        ],
        "matcher": "TodoWrite"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" compacting",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" agent-start",
            "type": "command"
          }
        ],
        "matcher": "Task"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" ended",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/sandbox-bootstrap.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-handoff.sh\" claude",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" started",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" waiting",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-session.sh\" stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-diff.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-journal.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-token-usage.sh\"",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/mailbox.sh\" stop-check",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" error",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" agent-stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-status.sh\" working",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/mailbox.sh\" inbox",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skein/bin/box-handoff.sh\" claude",
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "command": "bash $CLAUDE_PROJECT_DIR/.claude/skein/bin/statusline-command.sh",
    "refreshIntervalMs": 30000,
    "type": "command"
  },
  "tui": "fullscreen"
}