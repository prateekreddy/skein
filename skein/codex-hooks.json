{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" PermissionRequest box-status.sh notify-blocked",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" PostCompact box-status.sh compacted",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" PostToolUse box-status.sh working-tool",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" PostToolUse box-codex-telemetry.sh tool",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" PreCompact box-status.sh compacting",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" SessionStart sandbox-bootstrap.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" SessionStart box-handoff.sh codex",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" SessionStart box-status.sh started",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop box-status.sh waiting",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop box-session.sh stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop box-diff.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop box-journal.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop box-codex-telemetry.sh stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" Stop mailbox.sh stop-check",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" SubagentStart box-status.sh agent-start",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" SubagentStop box-status.sh agent-stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" UserPromptSubmit box-status.sh working",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" UserPromptSubmit box-codex-task.sh",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" UserPromptSubmit mailbox.sh inbox",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/skein/bin/box-codex-hook.sh\" UserPromptSubmit box-handoff.sh codex",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}