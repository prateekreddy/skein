# Copy to .env and adjust. Loaded automatically at startup (dotenv) by both `skein` and
# `skein-server`. Real environment variables always take precedence over this file.
# Full reference: README "Configuration".

# --- usually all you need ---
# Full path to the fleet registry (sandboxes.json). If unset, skein falls back to
# $SKEIN_SHARED/sandboxes.json, then <git-toplevel>/../skein-shared/.claude/sandboxes.json.
SKEIN_REGISTRY=/abs/path/to/skein-shared/.claude/sandboxes.json

# Repo to run git/gh in and to launch/attach from (relative *_CMD paths resolve here). Default: cwd.
SKEIN_REPO=/abs/path/to/your/repo

# Launch-a-box template; {branch} is substituted. Relative to SKEIN_REPO. Default: setup-sandbox.sh <branch>
# Quote any value containing a space — dotenv rejects unquoted spaces.
SKEIN_LAUNCH_CMD="dev-sandbox/setup-sandbox.sh {branch}"

# --- optional (quote values with spaces) ---
# SKEIN_ADDR=127.0.0.1:7878             # server bind address
# SKEIN_ALLOWED_ORIGINS=proxy.host      # extra WebSocket origins (loopback + *.ts.net always allowed)
# SKEIN_BASE=main                       # base branch for PR/merge
# SKEIN_ATTACH_CMD="sbx run --name {name} -- --continue"
# SKEIN_SHELL_CMD="sbx exec -it {name} /bin/bash"
# SKEIN_STOP_CMD="sbx stop {name}"
# SKEIN_DESTROY_CMD="sbx rm -f {name}"
# SKEIN_AI=on                           # opt into rationed Haiku enrichment
