#!/usr/bin/env python3
# skein's in-box tools: an MCP server over stdio, run by the agent's own CLI from the plugin's
# `.mcp.json` (box-plugin §2.3, SKEIN-1059).
#
# It runs INSIDE the box, as the box's uid, and its whole reach is the box's own reach. It holds no
# token and opens no socket: it reads a handful of files, writes into the box's own request
# drop-boxes, and answers on stdin/stdout. Three tools read:
#
#   skein_resources   the box's signal file, `$SKEIN_STATE/signals/resources.json`, as skein wrote it.
#   skein_top         this box's largest processes by memory or CPU, or the largest directories of
#                     its checkout. It never offers to stop anything: the kernel's limits are the
#                     ceiling, and this is only how the agent sees what it is holding.
#   skein_requests    the box's own package and git-write requests and questions, and the owner's
#                     answers.
#
# and three ask (SKEIN-1061), each into the box's own drop-box and nowhere else:
#
#   skein_request_package  `box-session.sh --request-package`, the path the sudo shim takes.
#   skein_request_write    `box-session.sh --request-write`, the path the git shim takes.
#   skein_ask_person       one file in `<fleet root>/.skein/asks/requests/<box>/`, a question for the
#                          fleet's owner, answered from the cockpit into the box's inbox.
#
# Each of the three refuses a box's sixth waiting request in its queue (`CAP`), and a question is at
# most 2 KB, text and options together (`MAX_ASK_BYTES`). The cap is the tool's courtesy to the
# agent; the cockpit enforces its own (`asks::list`), because a box can write its drop-box without
# this file.
#
# Two rules carry the security of this file, and each has a test that fails without it
# (`tests/plugin_tools.rs`):
#
# * **top reads `/proc` only for the pids in this box's own `cgroup.procs`.** Which cgroup is "own"
#   is the kernel's answer, `/proc/self/cgroup`, not an environment variable a box sets. A process
#   that is not in a box cgroup (a box started without cgroup delegation) gets no process list at
#   all, never the whole of `/proc`: the PID namespace is shared (SKEIN-964), so a fallback to
#   `/proc` would list every box's processes, which is exactly what this tool must not add.
# * **An answer is only ever read from the owner's inbox**, `$SKEIN_STATE/inbox/`, which the launcher
#   binds read-only into the box, so nothing in a box can have written it (`src/mailbox.rs`,
#   `owner_inbox`). The request files are the box's own, and every field in them is the box's word;
#   the `state` the host writes back into them is a courtesy copy and is never read here, the rule
#   `gitgate::decide` and `substrate::decide` keep on the host side.
#
# Python 3 standard library only, as `server-doorway.py` and `skein-resources` are: it runs in every
# box and installs nothing.

import json
import os
import re
import subprocess
import sys
import time

PROTOCOL = "2025-06-18"

# `valid_box` in `box-session.sh`: a box name is a path component before it is anything else.
BOX_NAME = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._-]*$")

TOP_DEFAULT = 10
TOP_MAX = 50

# The owner's numbers (box-plugin.md answer 2; feature-wording.md, SKEIN-1060).
CAP = 5
MAX_ASK_BYTES = 2048

# Tests only: the directory standing in for `/`, so `/proc` and `/sys` can be a fake tree. It moves
# nothing a box cannot already read.
ROOT = os.environ.get("SKEIN_TOOLS_FAKE_ROOT", "")


def real(path):
    return ROOT + path if ROOT else path


def read_text(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


# ------------------------------------------------------------------------------------------------
# skein_resources
# ------------------------------------------------------------------------------------------------


def resources(_args):
    state = os.environ.get("SKEIN_STATE", "")
    if not state:
        return {"error": "no-state", "state": None}
    path = os.path.join(state, "signals", "resources.json")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except OSError:
        return {"error": "no-signal-file", "path": path}
    except ValueError:
        return {"error": "unreadable-signal-file", "path": path}


# ------------------------------------------------------------------------------------------------
# skein_top
# ------------------------------------------------------------------------------------------------


def own_cgroup():
    """This process's cgroup directory, from the kernel, or None when it is not a box's.

    cgroup v2 writes one line, `0::/skein/<box>`. A box's cgroup is a leaf directly under `skein`
    (`box-session.sh`), and `skein/containers` is Docker's, not a box's.
    """
    try:
        lines = read_text(real("/proc/self/cgroup")).splitlines()
    except OSError:
        return None
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) != 3 or parts[0] != "0":
            continue
        rel = parts[2].strip()
        bits = rel.strip("/").split("/")
        if len(bits) == 2 and bits[0] == "skein" and bits[1] != "containers" and BOX_NAME.match(bits[1]):
            return real("/sys/fs/cgroup" + rel)
    return None


def own_pids(cgroup):
    """The pids in this box's cgroup. None when the file cannot be read: no list, not everybody's."""
    try:
        text = read_text(os.path.join(cgroup, "cgroup.procs"))
    except OSError:
        return None
    return sorted({int(p) for p in text.split() if p.isdigit()})


def clock_ticks():
    try:
        return os.sysconf("SC_CLK_TCK") or 100
    except (ValueError, OSError):
        return 100


def page_size():
    try:
        return os.sysconf("SC_PAGE_SIZE") or 4096
    except (ValueError, OSError):
        return 4096


def process(pid, uptime, hz, page):
    """One process of this box, read from `/proc/<pid>`. None when it has gone since the listing."""
    base = real("/proc/%d" % pid)
    try:
        stat = read_text(base + "/stat")
        statm = read_text(base + "/statm").split()
    except OSError:
        return None
    # `comm` is in parentheses and may itself hold spaces or parentheses; everything after the LAST
    # `)` is space-separated, starting at field 3 (state).
    close = stat.rfind(")")
    if close < 0:
        return None
    rest = stat[close + 2 :].split()
    try:
        ppid = int(rest[1])
        cpu = (int(rest[11]) + int(rest[12])) / hz
        started = int(rest[19]) / hz
        rss = int(statm[1]) * page
    except (IndexError, ValueError):
        return None
    try:
        raw = read_text(base + "/cmdline")
        command = raw.replace("\0", " ").strip()
    except OSError:
        command = ""
    if not command:
        command = "[" + stat[stat.find("(") + 1 : close] + "]"
    return {
        "pid": pid,
        "ppid": ppid,
        "rss_bytes": rss,
        "cpu_seconds": round(cpu, 1),
        "age_seconds": max(0, int(uptime - started)),
        # Reparented to init: its parent has exited and nothing is waiting on it. What a box that
        # spawns and does not reap leaves behind (`box_cgroup_kill`'s doc in `src/fleet/limits.rs`).
        "parentless": ppid <= 1,
        "command": command[:300],
    }


def checkout():
    """The top of the git checkout this server was started in, or its directory if there is none."""
    here = os.getcwd()
    d = here
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        up = os.path.dirname(d)
        if up == d:
            return here
        d = up


def top_disk(n):
    where = checkout()
    try:
        out = subprocess.run(
            ["du", "-x", "-k", "--max-depth=1", where],
            capture_output=True,
            text=True,
            timeout=120,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {"by": "disk", "error": "du-failed", "checkout": where}
    rows = []
    for line in out.splitlines():
        size, _, path = line.partition("\t")
        if not size.isdigit() or not path or path == where:
            continue
        rows.append({"path": path, "bytes": int(size) * 1024})
    rows.sort(key=lambda r: r["bytes"], reverse=True)
    return {"by": "disk", "checkout": where, "dirs": rows[:n]}


def top(args):
    by = args.get("by", "memory")
    if by not in ("memory", "cpu", "disk"):
        return {"error": "by-must-be-memory-cpu-or-disk"}
    try:
        n = int(args.get("n", TOP_DEFAULT))
    except (TypeError, ValueError):
        n = TOP_DEFAULT
    n = max(1, min(n, TOP_MAX))
    if by == "disk":
        return top_disk(n)
    cgroup = own_cgroup()
    if cgroup is None:
        return {"by": by, "error": "not-in-a-box-cgroup"}
    pids = own_pids(cgroup)
    if pids is None:
        return {"by": by, "error": "cgroup-unreadable"}
    try:
        uptime = float(read_text(real("/proc/uptime")).split()[0])
    except (OSError, ValueError, IndexError):
        uptime = time.monotonic()
    hz, page = clock_ticks(), page_size()
    procs = [p for p in (process(pid, uptime, hz, page) for pid in pids) if p]
    key = "rss_bytes" if by == "memory" else "cpu_seconds"
    procs.sort(key=lambda p: p[key], reverse=True)
    return {
        "by": by,
        "processes_in_box": len(procs),
        "parentless_in_box": sum(1 for p in procs if p["parentless"]),
        "processes": procs[:n],
    }


# ------------------------------------------------------------------------------------------------
# skein_requests
# ------------------------------------------------------------------------------------------------

# The two queues a box files into (`substrate_dir` and `gitgate_dir` in `box-session.sh`), and the
# fields of each that are the ASK. `state`, `decided` and anything else are not carried over.
QUEUES = (
    ("package", "substrate", ("kind", "packages")),
    ("write", "gitgate", ("repo", "reason")),
    ("question", "asks", ("question", "options")),
)


def inbox_answers():
    """Every answer in the owner's inbox, newest first.

    Only `kind: "answer"`: the inbox also carries notes such as `fleet-disk`, which answer nothing.
    """
    state = os.environ.get("SKEIN_STATE", "")
    if not state:
        return []
    inbox = os.path.join(state, "inbox")
    try:
        names = sorted(os.listdir(inbox))
    except OSError:
        return []
    out = []
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(inbox, name), encoding="utf-8") as f:
                m = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(m, dict) or m.get("kind") != "answer":
            continue
        out.append({"body": str(m.get("body", "")), "ts": str(m.get("ts", "")), "_name": name})
    # Newest first. `ts` is to the second, and a grant and its revocation can share one, so the file
    # name breaks the tie: skein names each message by the nanosecond it was written.
    out.sort(key=lambda m: (m["ts"], m.pop("_name")), reverse=True)
    return out


# What each queue's answer can say, in the owner's words (`mailbox::send_answer`): a decision, then
# for a package whether it installed, and for a write whether its grant was taken back.
OUTCOMES = {
    "package": r"granted|denied|installed|not installed: (?P<why>.+)",
    "write": r"granted|denied|revoked",
}


def answer_for(queue, request_id, answers):
    """The newest answer to this request: (the message, its state, why it did not install, or the
    owner's answer to a question).

    The body is the one skein writes, matched whole: `<queue> request <id>, <outcome>`, or for a
    question `question <id>, "<answer>"` and `question <id> was dismissed without an answer`
    (`mailbox::send_question_answer`). So a package answer never answers a write request that
    happens to carry the same id, an id is never matched as the prefix of a longer one, and an
    outcome of the other queue's is no answer at all.
    """
    if queue == "question":
        said = re.compile(r"^question " + re.escape(request_id) + r', "(?P<answer>.*)"$')
        dismissed = "question " + request_id + " was dismissed without an answer"
        for a in answers:
            if a["body"] == dismissed:
                return a, "dismissed", None
            m = said.match(a["body"])
            if m:
                return a, "answered", m.group("answer")
        return None, None, None
    shape = re.compile(
        r"^" + re.escape(queue) + r" request " + re.escape(request_id)
        + r", (?P<outcome>" + OUTCOMES[queue] + r")$"
    )
    for a in answers:
        m = shape.match(a["body"])
        if m:
            why = m.groupdict().get("why")
            return a, ("not installed" if why else m.group("outcome")), why
    return None, None, None


def own_queue(queue):
    """This box's own drop-box in one queue, or None when `$SKEIN_BOX` is not a box name.

    The name only chooses which directory to try. What makes it this box's is the mount: the
    launcher binds this one directory read-write and every other box's read-only, so a name that is
    not this box's is a write that fails.
    """
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return None
    fleet = os.environ.get("SKEIN_FLEET_ROOT") or "/boxes"
    return os.path.join(fleet, ".skein", queue, "requests", box)


def waiting_in(kind, queue, answers):
    """The ids of this box's requests in one queue that nobody has answered, oldest first.

    Answered is the inbox's word, never the file's, as in `requests` below.
    """
    d = own_queue(queue)
    try:
        names = sorted(os.listdir(d)) if d else []
    except OSError:
        return []
    rows = []
    for name in names:
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            with open(os.path.join(d, name), encoding="utf-8") as f:
                r = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(r, dict):
            continue
        rid = str(r.get("id") or name[: -len(".json")])
        if answer_for(kind, rid, answers)[0] is None:
            rows.append((str(r.get("asked", "")), rid))
    return [rid for _, rid in sorted(rows)]


def at_cap(kind, queue):
    """The refusal for a box that already has `CAP` waiting in this queue, or None."""
    waiting = waiting_in(kind, queue, inbox_answers())
    if len(waiting) < CAP:
        return None
    return reply(
        {"error": "at-cap", "waiting": waiting},
        "skein: you already have %d waiting: %s. Ask again once one is answered or dismissed. "
        "skein_requests lists them." % (CAP, ", ".join(waiting)),
    )


def requests(_args):
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return {"error": "no-box-name", "requests": []}
    fleet = os.environ.get("SKEIN_FLEET_ROOT") or "/boxes"
    answers = inbox_answers()
    out = []
    for kind, queue, fields in QUEUES:
        d = os.path.join(fleet, ".skein", queue, "requests", box)
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".json") or name.startswith("."):
                continue
            try:
                with open(os.path.join(d, name), encoding="utf-8") as f:
                    r = json.load(f)
            except (OSError, ValueError):
                continue
            if not isinstance(r, dict):
                continue
            rid = str(r.get("id") or name[: -len(".json")])
            row = {"queue": kind, "id": rid, "asked": str(r.get("asked", ""))}
            for field in fields:
                if field in r:
                    row[field] = r[field]
            # **Never `r["state"]`.** The box wrote this file and can write `granted` into it; the
            # only answer is one found in the inbox, which it cannot write.
            answer, decision, why = answer_for(kind, rid, answers)
            row["state"] = decision or "waiting"
            row["answer"] = answer
            if why is not None and kind == "question":
                row["answered"] = why
            elif why:
                row["why"] = why
            out.append(row)
    out.sort(key=lambda r: r["asked"])
    return {"box": box, "requests": out}


# ------------------------------------------------------------------------------------------------
# skein_request_package, skein_request_write, skein_ask_person
# ------------------------------------------------------------------------------------------------


class Reply(dict):
    """A tool's answer with a sentence for the agent after it, as the second content block."""

    def __init__(self, result, said):
        super().__init__(result)
        self.said = said


def reply(result, said):
    return Reply(result, said)


def launcher():
    """The launcher every box's shims call, where `fleet::box_session_path` installs it."""
    return os.path.join(os.environ.get("SKEIN_FLEET_ROOT") or "/boxes", ".skein", "box-session.sh")


def file_through_launcher(kind, queue, argv):
    """Run one of the launcher's two filing entry points, and say what it said.

    The launcher does the filing, so there is one path per queue: the same validation, the same
    collapse of a repeated ask, the same drop-box, and the same sentences the shims print. Its exit
    codes are its vocabulary: 0 filed (or already asked), 3 refused for the name, 4 not recorded.
    """
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return {"error": "no-box-name"}
    refused = at_cap(kind, queue)
    if refused is not None:
        return refused
    try:
        done = subprocess.run(
            ["bash", launcher()] + argv[:1] + [box] + argv[1:],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return {"error": "launcher-failed"}
    said = (done.stdout + done.stderr).strip()
    if done.returncode == 3:
        return reply({"error": "refused"}, said)
    if done.returncode != 0:
        return reply({"error": "not-recorded"}, said)
    m = re.search(r"[Rr]equest (\S+) is ", done.stdout)
    if not m:
        return reply({"error": "not-recorded"}, said)
    rid = m.group(1)
    _answer, decision, _why = answer_for(kind, rid, inbox_answers())
    return reply({"id": rid, "state": decision or "waiting"}, said)


def request_package(args):
    manager = args.get("manager")
    packages = args.get("packages")
    if manager not in ("apt", "npm"):
        return {"error": "manager-must-be-apt-or-npm"}
    if (
        not isinstance(packages, list)
        or not packages
        or not all(isinstance(p, str) and p and not p.startswith("-") for p in packages)
    ):
        return {"error": "packages-must-be-a-list-of-names"}
    tool = "apt-get" if manager == "apt" else "npm"
    return file_through_launcher("package", "substrate", ["--request-package", tool, "install"] + packages)


def request_write(args):
    repo = args.get("repo")
    why = args.get("why", "")
    if not isinstance(repo, str) or not repo:
        return {"error": "repo-must-be-owner/name"}
    if not isinstance(why, str):
        return {"error": "why-must-be-text"}
    return file_through_launcher("write", "gitgate", ["--request-write", repo] + ([why] if why else []))


def kb(n):
    """Bytes as the approved sentence prints them: KB, one decimal, rounded up so 2049 bytes is
    never "2.0 KB" beside a limit of 2 KB."""
    tenths = -(-n * 10 // 1024)
    return "%d.%d" % (tenths // 10, tenths % 10)


def ask_person(args):
    question = args.get("question")
    options = args.get("options", [])
    if not isinstance(question, str) or not question.strip():
        return {"error": "question-must-be-text"}
    if not isinstance(options, list) or not all(
        isinstance(o, str) and o.strip() and "\n" not in o and "\r" not in o for o in options
    ):
        return {"error": "options-must-be-one-line-each"}
    size = len(question.encode("utf-8")) + sum(len(o.encode("utf-8")) for o in options)
    if size > MAX_ASK_BYTES:
        return reply(
            {"error": "too-long", "bytes": size},
            "skein: a question is at most 2 KB and this one is %s KB. Shorten it and ask again." % kb(size),
        )
    d = own_queue("asks")
    if d is None:
        return {"error": "no-box-name"}
    refused = at_cap("question", "asks")
    if refused is not None:
        return refused
    # The launcher made this directory outside the box and bound it in; in a box it exists already.
    # Writability is asked, not assumed, for `request_package`'s reason: `makedirs` succeeds on a
    # neighbour's directory that exists and is read-only here.
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        pass
    if not os.access(d, os.W_OK):
        return {"error": "not-recorded", "queue": d}
    answers = inbox_answers()
    for _ in range(20):
        rid = "q-" + os.urandom(4).hex()
        if not os.path.exists(os.path.join(d, rid + ".json")) and answer_for("question", rid, answers)[0] is None:
            break
    else:
        return {"error": "not-recorded", "queue": d}
    body = {
        "id": rid,
        "box": os.environ.get("SKEIN_BOX", ""),
        "question": question,
        "options": options,
        "asked": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    tmp = os.path.join(d, ".tmp." + rid)
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(body, f)
        # Named only once complete: the cockpit reads this directory, and a half-written ask is a
        # parse error there rather than a question that arrives a moment later.
        os.replace(tmp, os.path.join(d, rid + ".json"))
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return {"error": "not-recorded", "queue": d}
    return reply(
        {"id": rid, "state": "waiting"},
        "skein: asked the person (question %s). The answer arrives in your inbox; nothing is answered yet." % rid,
    )


# ------------------------------------------------------------------------------------------------
# The protocol
# ------------------------------------------------------------------------------------------------

TOOLS = [
    {
        "name": "skein_resources",
        "description": "This box's resource signal file as skein wrote it: its disk, memory, "
        "throttle rate and process count against its limits, and anything skein asks of it.",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_top",
        "description": "This box's largest processes by memory or CPU, with each one's age and "
        "whether it has no parent, or the largest directories of its checkout by disk.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "by": {"type": "string", "enum": ["memory", "cpu", "disk"]},
                "n": {"type": "integer", "minimum": 1, "maximum": TOP_MAX},
            },
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_requests",
        "description": "This box's own package and repository-write requests and questions, and "
        "the owner's answer to each, from the inbox only the owner can write.",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_request_package",
        "description": "Ask the fleet's owner to install a system package for every box. Nothing "
        "is installed until they approve it in the cockpit; the answer arrives in your inbox.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "manager": {"type": "string", "enum": ["apt", "npm"]},
                "packages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            },
            "required": ["manager", "packages"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
    {
        "name": "skein_request_write",
        "description": "Ask the fleet's owner for write access to a repository that is not this "
        "box's own (owner/name), and say why. The answer arrives in your inbox.",
        "inputSchema": {
            "type": "object",
            "properties": {"repo": {"type": "string"}, "why": {"type": "string"}},
            "required": ["repo", "why"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
    {
        "name": "skein_ask_person",
        "description": "Ask the fleet's owner a question, at most 2 KB, optionally with the answers "
        "to choose from. They see it in the cockpit as your own words; the answer arrives in your "
        "inbox. At most 5 may wait at once.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "question": {"type": "string"},
                "options": {"type": "array", "items": {"type": "string"}},
            },
            "required": ["question"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
]

HANDLERS = {
    "skein_resources": resources,
    "skein_top": top,
    "skein_requests": requests,
    "skein_request_package": request_package,
    "skein_request_write": request_write,
    "skein_ask_person": ask_person,
}


def call(params):
    name = params.get("name")
    args = params.get("arguments") or {}
    handler = HANDLERS.get(name)
    if handler is None or not isinstance(args, dict):
        return {"content": [{"type": "text", "text": json.dumps({"error": "unknown-tool"})}], "isError": True}
    result = handler(args)
    content = [{"type": "text", "text": json.dumps(dict(result), indent=1)}]
    said = getattr(result, "said", "")
    if said:
        content.append({"type": "text", "text": said})
    return {"content": content, "isError": "error" in result}


def answer(msg):
    """The response to one message, or None for a notification."""
    method = msg.get("method")
    mid = msg.get("id")
    if mid is None:
        return None
    params = msg.get("params") or {}
    if method == "initialize":
        result = {
            "protocolVersion": params.get("protocolVersion") or PROTOCOL,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "skein", "version": "0.1.0"},
        }
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        result = call(params)
    elif method == "ping":
        result = {}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "method not found"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            if not isinstance(msg, dict):
                continue
            try:
                reply = answer(msg)
            except Exception:  # noqa: BLE001 - one bad call must not end the server
                reply = {
                    "jsonrpc": "2.0",
                    "id": msg.get("id"),
                    "error": {"code": -32603, "message": "internal error"},
                }
        if reply is not None:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
