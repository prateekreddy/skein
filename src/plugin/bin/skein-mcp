#!/usr/bin/env python3
# skein's in-box tools: an MCP server over stdio, run by the agent's own CLI from the plugin's
# `.mcp.json` (box-plugin §2.3, SKEIN-1059).
#
# It runs INSIDE the box, as the box's uid, and its whole reach is the box's own reach. It holds no
# token and opens no socket: it reads a handful of files, writes into the box's own request
# drop-boxes, and answers on stdin/stdout. Three tools read:
#
#   skein_resources   the box's signal file, `$SKEIN_STATE/signals/resources.json`, as skein wrote it.
#   skein_top         this box's largest processes by memory or CPU, or by disk what the box is
#                     charged for: skein's list of its caches, build output and scratchpads, its
#                     checkout's largest directories, and the repo's shared cache on a line of its
#                     own. It never offers to stop anything: the kernel's limits are the ceiling,
#                     and this is only how the agent sees what it is holding.
#   skein_requests    the box's own package and git-write requests and questions, and the owner's
#                     answers. `skein-mcp requests` answers the same on the command line, which is
#                     how the mod's compaction keeper reads it (SKEIN-1364).
#
# and three ask (SKEIN-1061), each into the box's own drop-box and nowhere else:
#
#   skein_request_package  `box-session.sh --request-package`, the path the sudo shim takes.
#   skein_request_write    `box-session.sh --request-write`, the path the git shim takes.
#   skein_ask_person       one file in `<fleet root>/.skein/asks/requests/<box>/`, a question for the
#                          fleet's owner, answered from the cockpit into the box's inbox.
#
# Each of the three refuses a box's sixth waiting request in its queue (`CAP`), and a question is at
# most 2 KB, text and options together (`MAX_ASK_BYTES`). The cap is the tool's courtesy to the
# agent; the cockpit enforces its own (`asks::list`), because a box can write its drop-box without
# this file.
#
# Two rules carry the security of this file, and each has a test that fails without it
# (`tests/plugin_tools.rs`):
#
# * **top reads `/proc` only for the pids in this box's own `cgroup.procs`.** Which cgroup is "own"
#   is the kernel's answer, `/proc/self/cgroup`, not an environment variable a box sets. A process
#   that is not in a box cgroup (a box started without cgroup delegation) gets no process list at
#   all, never the whole of `/proc`: the PID namespace is shared (SKEIN-964), so a fallback to
#   `/proc` would list every box's processes, which is exactly what this tool must not add.
# * **An answer is only ever read from the owner's inbox**, `$SKEIN_STATE/inbox/`, which the launcher
#   binds read-only into the box, so nothing in a box can have written it (`src/mailbox.rs`,
#   `owner_inbox`). The request files are the box's own, and every field in them is the box's word;
#   the `state` the host writes back into them is a courtesy copy and is never read here, the rule
#   `gitgate::decide` and `substrate::decide` keep on the host side.
#
# And one removes (SKEIN-1356), inside the box and as the box:
#
#   skein_clean       what in this box can be removed and made again, from the list skein writes into
#                     the signal file, and the removal of chosen items from that list. The same
#                     function answers `skein-mcp clean [PATH...]` on the command line, so a caller
#                     that is not an MCP client gets the one implementation and not a second.
#
# Three more rules carry `skein_clean`, each with a test that fails without it:
#
# * **It never decides what is cleanable.** skein lists it (`fleet::box_cleanables` and
#   `fleet::repo_cache_for_box`, written by `resource_signal::clean_list`), the same list the box's
#   settings show; a path that is not on the list as it stands now is refused, and nothing is removed.
# * **A removal never follows a link and never leaves the filesystem it started on.** Every
#   directory is opened from the one above it with `O_NOFOLLOW`, checked to be on the device the
#   listed root is on, and emptied through its descriptor (`remove_listed`); a link is unlinked as
#   itself. A mount found inside a listed item is not entered: the rest of the item is removed,
#   the mount and the directories above it are kept, and the item is reported as not removed. A box can swap a directory for a link at any moment, and a removal by path would follow it.
# * **The repo's shared cache only while no other box of the repo runs**, the host's rule for its
#   own clean (`fleet::clean_repo_cache`). This box cannot see its siblings, so it acts on skein's
#   word in the signal file, and only while that word is recent (`SIBLINGS_FRESH_SECONDS`).
#
# Python 3 standard library only, as `server-doorway.py` and `skein-resources` are: it runs in every
# box and installs nothing.

import json
import os
import re
import stat
import subprocess
import sys
import time
from datetime import datetime, timezone

PROTOCOL = "2025-06-18"

# `valid_box` in `box-session.sh`: a box name is a path component before it is anything else.
BOX_NAME = re.compile(r"^[A-Za-z0-9._][A-Za-z0-9._-]*$")

TOP_DEFAULT = 10
TOP_MAX = 50

# The owner's numbers (box-plugin.md answer 2; feature-wording.md, SKEIN-1060).
CAP = 5
MAX_ASK_BYTES = 2048

# Tests only: the directory standing in for `/`, so `/proc` and `/sys` can be a fake tree. It moves
# nothing a box cannot already read.
ROOT = os.environ.get("SKEIN_TOOLS_FAKE_ROOT", "")


def real(path):
    return ROOT + path if ROOT else path


def read_text(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        return f.read()


# ------------------------------------------------------------------------------------------------
# skein_resources
# ------------------------------------------------------------------------------------------------


def resources(_args):
    state = os.environ.get("SKEIN_STATE", "")
    if not state:
        return {"error": "no-state", "state": None}
    path = os.path.join(state, "signals", "resources.json")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except OSError:
        return {"error": "no-signal-file", "path": path}
    except ValueError:
        return {"error": "unreadable-signal-file", "path": path}


# ------------------------------------------------------------------------------------------------
# skein_top
# ------------------------------------------------------------------------------------------------


def own_cgroup():
    """This process's cgroup directory, from the kernel, or None when it is not a box's.

    cgroup v2 writes one line, `0::/skein/<box>`. A box's cgroup is a leaf directly under `skein`
    (`box-session.sh`), and `skein/containers` is Docker's, not a box's.
    """
    try:
        lines = read_text(real("/proc/self/cgroup")).splitlines()
    except OSError:
        return None
    for line in lines:
        parts = line.split(":", 2)
        if len(parts) != 3 or parts[0] != "0":
            continue
        rel = parts[2].strip()
        bits = rel.strip("/").split("/")
        if len(bits) == 2 and bits[0] == "skein" and bits[1] != "containers" and BOX_NAME.match(bits[1]):
            return real("/sys/fs/cgroup" + rel)
    return None


def own_pids(cgroup):
    """The pids in this box's cgroup. None when the file cannot be read: no list, not everybody's."""
    try:
        text = read_text(os.path.join(cgroup, "cgroup.procs"))
    except OSError:
        return None
    return sorted({int(p) for p in text.split() if p.isdigit()})


def clock_ticks():
    try:
        return os.sysconf("SC_CLK_TCK") or 100
    except (ValueError, OSError):
        return 100


def page_size():
    try:
        return os.sysconf("SC_PAGE_SIZE") or 4096
    except (ValueError, OSError):
        return 4096


def process(pid, uptime, hz, page):
    """One process of this box, read from `/proc/<pid>`. None when it has gone since the listing."""
    base = real("/proc/%d" % pid)
    try:
        stat = read_text(base + "/stat")
        statm = read_text(base + "/statm").split()
    except OSError:
        return None
    # `comm` is in parentheses and may itself hold spaces or parentheses; everything after the LAST
    # `)` is space-separated, starting at field 3 (state).
    close = stat.rfind(")")
    if close < 0:
        return None
    rest = stat[close + 2 :].split()
    try:
        ppid = int(rest[1])
        cpu = (int(rest[11]) + int(rest[12])) / hz
        started = int(rest[19]) / hz
        rss = int(statm[1]) * page
    except (IndexError, ValueError):
        return None
    try:
        raw = read_text(base + "/cmdline")
        command = raw.replace("\0", " ").strip()
    except OSError:
        command = ""
    if not command:
        command = "[" + stat[stat.find("(") + 1 : close] + "]"
    return {
        "pid": pid,
        "ppid": ppid,
        "rss_bytes": rss,
        "cpu_seconds": round(cpu, 1),
        "age_seconds": max(0, int(uptime - started)),
        # Reparented to init: its parent has exited and nothing is waiting on it. What a box that
        # spawns and does not reap leaves behind (`box_cgroup_kill`'s doc in `src/fleet/limits.rs`).
        "parentless": ppid <= 1,
        "command": command[:300],
    }


def checkout():
    """The top of the git checkout this server was started in, or its directory if there is none."""
    here = os.getcwd()
    d = here
    while True:
        if os.path.exists(os.path.join(d, ".git")):
            return d
        up = os.path.dirname(d)
        if up == d:
            return here
        d = up


def top_disk(n):
    where = checkout()
    try:
        out = subprocess.run(
            ["du", "-x", "-k", "--max-depth=1", where],
            capture_output=True,
            text=True,
            timeout=120,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {"by": "disk", "error": "du-failed", "checkout": where}
    rows = []
    for line in out.splitlines():
        size, _, path = line.partition("\t")
        if not size.isdigit() or not path or path == where:
            continue
        rows.append({"path": path, "bytes": int(size) * 1024})
    rows.sort(key=lambda r: r["bytes"], reverse=True)
    return {"by": "disk", "checkout": where, "dirs": rows[:n]}


def top_disk_all(n):
    """`skein_top` by disk: what this box is charged for, and its repo's shared cache beside it.

    The checkout's largest directories as before, and from the signal file skein wrote: the box's
    disk against its allowance, its cleanable items by kind, and the repo's shared download cache on
    a line of its own, which is counted against no box.
    """
    out = top_disk(n)
    sig = signal_file()
    if not isinstance(sig, dict):
        out["cleanable"] = {"error": "no-signal-file"}
        return out
    disk = sig.get("disk") if isinstance(sig.get("disk"), dict) else {}
    out["charged_mb"] = disk.get("mb")
    out["limit_mb"] = disk.get("limit_mb")
    listing = clean_rows(sig)
    if "error" in listing:
        out["cleanable"] = {"error": listing["error"]}
        return out
    own = [r for r in listing["items"] if r["where"] == "box"]
    by_kind = {}
    for r in own:
        by_kind[r["kind"]] = by_kind.get(r["kind"], 0) + r["bytes"]
    out["cleanable"] = {
        "listed_at": listing["listed_at"],
        "bytes_by_kind": by_kind,
        "items": [
            {k: r[k] for k in ("path", "in_box", "kind", "bytes", "safe_now")} for r in own[:n]
        ],
        "how": "skein_clean removes them",
    }
    shared = listing.get("shared_repo_cache")
    if shared is not None:
        out["shared_repo_cache"] = shared
    return out


def top(args):
    by = args.get("by", "memory")
    if by not in ("memory", "cpu", "disk"):
        return {"error": "by-must-be-memory-cpu-or-disk"}
    try:
        n = int(args.get("n", TOP_DEFAULT))
    except (TypeError, ValueError):
        n = TOP_DEFAULT
    n = max(1, min(n, TOP_MAX))
    if by == "disk":
        return top_disk_all(n)
    cgroup = own_cgroup()
    if cgroup is None:
        return {"by": by, "error": "not-in-a-box-cgroup"}
    pids = own_pids(cgroup)
    if pids is None:
        return {"by": by, "error": "cgroup-unreadable"}
    try:
        uptime = float(read_text(real("/proc/uptime")).split()[0])
    except (OSError, ValueError, IndexError):
        uptime = time.monotonic()
    hz, page = clock_ticks(), page_size()
    procs = [p for p in (process(pid, uptime, hz, page) for pid in pids) if p]
    key = "rss_bytes" if by == "memory" else "cpu_seconds"
    procs.sort(key=lambda p: p[key], reverse=True)
    return {
        "by": by,
        "processes_in_box": len(procs),
        "parentless_in_box": sum(1 for p in procs if p["parentless"]),
        "processes": procs[:n],
    }


# ------------------------------------------------------------------------------------------------
# skein_clean
# ------------------------------------------------------------------------------------------------

# `CLEAN_SIBLINGS_FRESH` in `src/resource_signal.rs`: how recent skein's word that no other box of
# the repo is running must be before the repo's shared cache is removed.
SIBLINGS_FRESH_SECONDS = 180

# skein lists a box's items every five minutes (`CLEAN_LIST_EVERY`); a list three periods old means
# skein is not looking, and nothing on it is removed.
LIST_STALE_SECONDS = 900

# What this box's agent may remove at any time, because it knows what it is running (owner,
# 2026-10-30). A scratchpad is listed and not removed here: it may be another session's.
ANY_TIME = ("download cache", "build output")


def signal_file():
    """The signal file as skein wrote it, or None."""
    state = os.environ.get("SKEIN_STATE", "")
    if not state:
        return None
    try:
        with open(os.path.join(state, "signals", "resources.json"), encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def age_seconds(stamp):
    """Seconds since an RFC3339 stamp the way skein writes it (`2026-10-30T10:00:00Z`), or None."""
    if not isinstance(stamp, str):
        return None
    try:
        then = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return time.time() - then.timestamp()


def same_dir(fleet_path, seen):
    """Whether `fleet_path`, a real directory and not a link, is the directory the box sees at
    `seen`: one inode, which is what a bind mount of one onto the other makes."""
    try:
        a = os.lstat(fleet_path)
        b = os.stat(seen)
    except OSError:
        return False
    return stat.S_ISDIR(a.st_mode) and (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)


def box_view(box_root):
    """Where this box sees its own directory's parts, as (fleet prefix, in-box prefix) pairs, or
    None when `box_root` is not this box's directory.

    The paths skein writes are the fleet's. The launcher binds the box directory back at that same
    path, its `home` at `$HOME` and its `vartmp` at `/var/tmp` (`box-session.sh`). So the check is
    the mount's own answer: `<box_root>/home` and `$HOME` must be one directory. A list that names
    some other directory is refused whole rather than mapped.
    """
    home = os.environ.get("HOME", "")
    if not isinstance(box_root, str) or not box_root.startswith("/") or not home:
        return None
    if not same_dir(os.path.join(box_root, "home"), home):
        return None
    views = [(os.path.join(box_root, "home"), home.rstrip("/") or "/")]
    if same_dir(os.path.join(box_root, "vartmp"), "/var/tmp"):
        views.append((os.path.join(box_root, "vartmp"), "/var/tmp"))
    return views


def under(path, root):
    return isinstance(path, str) and isinstance(root, str) and path.startswith(root.rstrip("/") + "/")


def in_box(path, views):
    """`path` as this box's agent sees it: `$HOME/…` for the box's home, `/var/tmp/…` for its
    `vartmp`, and the path itself elsewhere, which the launcher binds at its own name."""
    for prefix, seen in views:
        if path == prefix or under(path, prefix):
            return seen + path[len(prefix):]
    return path


def exists(path):
    try:
        os.lstat(path)
        return True
    except OSError:
        return False


def clean_rows(sig):
    """Every item on skein's list for this box that is still there, with where the box sees it and
    whether it may be removed now, and why not when it may not."""
    clean = sig.get("clean") if isinstance(sig, dict) else None
    if not isinstance(clean, dict):
        return {"error": "not-listed-yet"}
    box_root = clean.get("box_root")
    views = box_view(box_root)
    age = age_seconds(clean.get("at"))
    stale = age is None or age > LIST_STALE_SECONDS
    rows = []
    for it in clean.get("items") or []:
        if not isinstance(it, dict) or not under(it.get("path"), box_root):
            continue
        path = it["path"]
        if not exists(path):
            continue
        kind = str(it.get("kind", ""))
        why = None
        if views is None:
            why = "skein listed a directory that is not this box's, so nothing on the list is removed"
        elif stale:
            why = "skein has not listed this box's disk lately; try again in a few minutes"
        elif kind not in ANY_TIME:
            why = "a scratchpad may belong to a session still running in this box"
        rows.append({
            "path": path,
            "in_box": in_box(path, views or []),
            "kind": kind,
            "bytes": int(it.get("bytes") or 0),
            "where": "box",
            "root": box_root,
            "safe_now": why is None,
            "why_not": why,
        })
    out = {"listed_at": clean.get("at"), "items": rows}
    rc = clean.get("repo_cache")
    if isinstance(rc, dict) and isinstance(rc.get("path"), str):
        running = int(rc.get("others_running") or 0)
        unknown = int(rc.get("others_unknown") or 0)
        quiet = age_seconds(rc.get("none_running_at"))
        if running:
            why = "%d other %s of this repo %s running, and every box of the repo shares this cache" % (
                running, "box" if running == 1 else "boxes", "is" if running == 1 else "are")
        elif unknown:
            why = "skein cannot tell whether %d other %s of this repo %s running" % (
                unknown, "box" if unknown == 1 else "boxes", "is" if unknown == 1 else "are")
        elif quiet is None or quiet > SIBLINGS_FRESH_SECONDS:
            why = "skein has not confirmed in the last few minutes that no other box of this repo is running"
        elif stale:
            why = "skein has not listed this cache lately; try again in a few minutes"
        else:
            why = None
        for it in rc.get("items") or []:
            if not isinstance(it, dict) or not under(it.get("path"), rc["path"]) or not exists(it["path"]):
                continue
            rows.append({
                "path": it["path"],
                "in_box": it["path"],
                "kind": "shared download cache",
                "bytes": int(it.get("bytes") or 0),
                "where": "shared",
                "root": rc["path"],
                "safe_now": why is None,
                "why_not": why,
            })
        out["shared_repo_cache"] = {
            "path": rc["path"],
            "bytes": int(rc.get("bytes") or 0),
            "shared_with": "every box of this repo",
            "counted_against_this_box": False,
            "safe_to_clean_now": why is None,
            "why_not": why,
        }
    return out


class Refused(Exception):
    pass


DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)


def safe_removal_supported():
    """Whether this Python can remove through descriptors: every call `remove_listed` makes, taking
    a directory descriptor and not following a link. The same test CPython makes before it calls its
    own `rmtree` safe against links."""
    return (
        os.open in os.supports_dir_fd
        and os.stat in os.supports_dir_fd
        and os.unlink in os.supports_dir_fd
        and os.rmdir in os.supports_dir_fd
        and os.stat in os.supports_follow_symlinks
        and os.scandir in os.supports_fd
    )


def open_dir_at(parent, name, dev, seen=None):
    """Open directory `name` under the descriptor `parent`, never through a link. None when it is on
    another filesystem than `dev`: a mount, which is somebody else's and is left alone."""
    if seen is not None and seen.st_dev != dev:
        return None
    try:
        fd = os.open(name, DIR_FLAGS, dir_fd=parent)
    except OSError as e:
        raise Refused("part of this path is now a link, so skein left it alone") from e
    st = os.fstat(fd)
    if st.st_dev != dev:
        os.close(fd)
        return None
    if seen is not None and st.st_ino != seen.st_ino:
        os.close(fd)
        raise Refused("part of this path changed while skein removed it, so skein left the rest alone")
    return fd


def names_in(fd):
    with os.scandir(fd) as it:
        return [e.name for e in it]


def remove_tree_at(parent, name, dev):
    """Remove `name` under the descriptor `parent` and everything in it that is on `dev`, and return
    the paths, relative to `parent`, of the mounts inside it that were left alone.

    A link is unlinked as itself; a directory is opened with `O_NOFOLLOW` from its parent's
    descriptor; a directory on another filesystem (a mount) is not entered, and neither it nor any
    directory above it is removed, so everything in the mount survives and the rest is freed.
    Iterative, so a deep `node_modules` cannot exhaust the stack."""
    st = os.stat(name, dir_fd=parent, follow_symlinks=False)
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent)
        return []
    top_fd = open_dir_at(parent, name, dev, st)
    if top_fd is None:
        return [name]
    # Each frame: parent descriptor, name, own descriptor, names left, whether a mount is below it.
    stack = [[parent, name, top_fd, names_in(top_fd), False]]
    kept = []
    try:
        while stack:
            frame = stack[-1]
            if frame[3]:
                kid = frame[3].pop()
                kst = os.stat(kid, dir_fd=frame[2], follow_symlinks=False)
                if stat.S_ISDIR(kst.st_mode):
                    kfd = open_dir_at(frame[2], kid, dev, kst)
                    if kfd is None:
                        kept.append("/".join([f[1] for f in stack] + [kid]))
                        for f in stack:
                            f[4] = True
                        continue
                    stack.append([frame[2], kid, kfd, None, False])
                    stack[-1][3] = names_in(kfd)
                else:
                    os.unlink(kid, dir_fd=frame[2])
            else:
                stack.pop()
                os.close(frame[2])
                if not frame[4]:
                    os.rmdir(frame[1], dir_fd=frame[0])
    finally:
        for frame in stack:
            try:
                os.close(frame[2])
            except OSError:
                pass
    return kept


def remove_listed(root, path):
    """Remove the listed directory `path` under `root`, walking down from `root` one directory at a
    time: never through a link, never off `root`'s filesystem. None when it was already gone, else
    the mounts inside it that were left alone, as paths under `path`'s parent."""
    if not under(path, root):
        raise Refused("not under the place skein listed it in")
    parts = path[len(root.rstrip("/")) + 1:].split("/")
    if any(p in ("", ".", "..") for p in parts):
        raise Refused("not a plain path")
    try:
        fd = os.open(root, DIR_FLAGS)
    except OSError as e:
        raise Refused("the place skein listed it in is gone or is a link") from e
    try:
        dev = os.fstat(fd).st_dev
        for part in parts[:-1]:
            nxt = open_dir_at(fd, part, dev)
            if nxt is None:
                raise Refused("part of this path is on another filesystem, so skein left it alone")
            os.close(fd)
            fd = nxt
        try:
            st = os.stat(parts[-1], dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            return None
        if not stat.S_ISDIR(st.st_mode):
            raise Refused("this is now a link or a file, so skein left it alone")
        return remove_tree_at(fd, parts[-1], dev)
    finally:
        os.close(fd)


def human(n):
    """Bytes as the signal file's words print them: `3.2G`, or `120M` under a gigabyte."""
    mib = n / (1024 * 1024)
    if mib >= 1024:
        return "%.1fG" % (mib / 1024)
    return "%dM" % max(1, round(mib)) if n else "0M"


def clean(args):
    paths = args.get("paths")
    sig = signal_file()
    if not isinstance(sig, dict):
        return {"error": "no-signal-file"}
    listing = clean_rows(sig)
    if "error" in listing:
        return reply({"error": listing["error"]},
                     "skein: skein has not listed this box's disk yet. Try again in a few minutes.")
    rows = listing["items"]
    if not paths:
        visible = [{k: v for k, v in r.items() if k != "root"} for r in rows]
        out = {
            "listed_at": listing["listed_at"],
            "items": visible,
            "removable_now_bytes": sum(r["bytes"] for r in rows if r["safe_now"]),
        }
        if "shared_repo_cache" in listing:
            out["shared_repo_cache"] = listing["shared_repo_cache"]
        return out
    if not isinstance(paths, list) or not all(isinstance(p, str) and p for p in paths):
        return {"error": "paths-must-be-a-list-of-paths"}
    chosen, missing = [], []
    for p in paths:
        hit = next((r for r in rows if p in (r["path"], r["in_box"])), None)
        if hit is None:
            missing.append(p)
        elif hit not in chosen:
            chosen.append(hit)
    if missing:
        return reply(
            {"error": "not-on-the-list", "paths": missing},
            "skein: removed nothing. Not on this box's list now: %s. Call skein_clean with no paths "
            "to see what can be removed." % ", ".join(missing),
        )
    held = [r for r in chosen if not r["safe_now"]]
    if held:
        return reply(
            {"error": "not-safe-now", "paths": [{"path": r["path"], "why": r["why_not"]} for r in held]},
            "skein: removed nothing. %s" % " ".join("%s: %s." % (r["in_box"], r["why_not"]) for r in held),
        )
    if not safe_removal_supported():
        return reply({"error": "unsafe-python"},
                     "skein: removed nothing. This Python cannot remove without following links.")
    done = {"removed": [], "freed_bytes": 0, "failed": []}
    for r in chosen:
        try:
            kept = remove_listed(r["root"], r["path"])
            if kept:
                parent = os.path.dirname(r["in_box"])
                done["failed"].append({
                    "path": r["in_box"],
                    "why": "removed all of it but %s, which %s another filesystem mounted inside it"
                    % (", ".join(os.path.join(parent, k) for k in kept),
                       "is" if len(kept) == 1 else "are"),
                    "left_alone": [os.path.join(parent, k) for k in kept],
                })
            elif kept is not None:
                done["removed"].append(r["in_box"])
                done["freed_bytes"] += r["bytes"]
        except Refused as e:
            done["failed"].append({"path": r["in_box"], "why": str(e)})
        except OSError as e:
            done["failed"].append({"path": r["in_box"], "why": e.strerror or str(e)})
    said = "skein: removed %d, about %s." % (len(done["removed"]), human(done["freed_bytes"]))
    if done["failed"]:
        said += " Could not remove: %s." % "; ".join("%s (%s)" % (f["path"], f["why"]) for f in done["failed"])
    if any(r["where"] == "box" for r in chosen):
        said += " This box's disk figure catches up within five minutes."
    return reply(done, said)


# ------------------------------------------------------------------------------------------------
# skein_requests
# ------------------------------------------------------------------------------------------------

# The two queues a box files into (`substrate_dir` and `gitgate_dir` in `box-session.sh`), and the
# fields of each that are the ASK. `state`, `decided` and anything else are not carried over.
QUEUES = (
    ("package", "substrate", ("kind", "packages")),
    ("write", "gitgate", ("repo", "reason")),
    ("question", "asks", ("question", "options")),
)


def inbox_answers():
    """Every answer in the owner's inbox, newest first.

    Only `kind: "answer"`: the inbox also carries notes such as `fleet-disk`, which answer nothing.
    """
    state = os.environ.get("SKEIN_STATE", "")
    if not state:
        return []
    inbox = os.path.join(state, "inbox")
    try:
        names = sorted(os.listdir(inbox))
    except OSError:
        return []
    out = []
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(inbox, name), encoding="utf-8") as f:
                m = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(m, dict) or m.get("kind") != "answer":
            continue
        out.append({"body": str(m.get("body", "")), "ts": str(m.get("ts", "")), "_name": name})
    # Newest first. `ts` is to the second, and a grant and its revocation can share one, so the file
    # name breaks the tie: skein names each message by the nanosecond it was written.
    out.sort(key=lambda m: (m["ts"], m.pop("_name")), reverse=True)
    return out


# What each queue's answer can say, in the owner's words (`mailbox::send_answer`): a decision, then
# for a package whether it installed, and for a write whether its grant was taken back.
OUTCOMES = {
    "package": r"granted|denied|installed|not installed: (?P<why>.+)",
    "write": r"granted|denied|revoked",
}


def answer_for(queue, request_id, answers):
    """The newest answer to this request: (the message, its state, why it did not install, or the
    owner's answer to a question).

    The body is the one skein writes, matched whole: `<queue> request <id>, <outcome>`, or for a
    question `question <id>, "<answer>"` and `question <id> was dismissed without an answer`
    (`mailbox::send_question_answer`). So a package answer never answers a write request that
    happens to carry the same id, an id is never matched as the prefix of a longer one, and an
    outcome of the other queue's is no answer at all.
    """
    if queue == "question":
        said = re.compile(r"^question " + re.escape(request_id) + r', "(?P<answer>.*)"$')
        dismissed = "question " + request_id + " was dismissed without an answer"
        for a in answers:
            if a["body"] == dismissed:
                return a, "dismissed", None
            m = said.match(a["body"])
            if m:
                return a, "answered", m.group("answer")
        return None, None, None
    shape = re.compile(
        r"^" + re.escape(queue) + r" request " + re.escape(request_id)
        + r", (?P<outcome>" + OUTCOMES[queue] + r")$"
    )
    for a in answers:
        m = shape.match(a["body"])
        if m:
            why = m.groupdict().get("why")
            return a, ("not installed" if why else m.group("outcome")), why
    return None, None, None


def own_queue(queue):
    """This box's own drop-box in one queue, or None when `$SKEIN_BOX` is not a box name.

    The name only chooses which directory to try. What makes it this box's is the mount: the
    launcher binds this one directory read-write and every other box's read-only, so a name that is
    not this box's is a write that fails.
    """
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return None
    fleet = os.environ.get("SKEIN_FLEET_ROOT") or "/boxes"
    return os.path.join(fleet, ".skein", queue, "requests", box)


def waiting_in(kind, queue, answers):
    """The ids of this box's requests in one queue that nobody has answered, oldest first.

    Answered is the inbox's word, never the file's, as in `requests` below.
    """
    d = own_queue(queue)
    try:
        names = sorted(os.listdir(d)) if d else []
    except OSError:
        return []
    rows = []
    for name in names:
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            with open(os.path.join(d, name), encoding="utf-8") as f:
                r = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(r, dict):
            continue
        rid = str(r.get("id") or name[: -len(".json")])
        if answer_for(kind, rid, answers)[0] is None:
            rows.append((str(r.get("asked", "")), rid))
    return [rid for _, rid in sorted(rows)]


def at_cap(kind, queue):
    """The refusal for a box that already has `CAP` waiting in this queue, or None."""
    waiting = waiting_in(kind, queue, inbox_answers())
    if len(waiting) < CAP:
        return None
    # The ending names what frees a slot in THIS queue: the owner answers or dismisses a question,
    # and grants or denies a package or a write (the owner's words, SKEIN-1061).
    frees = "answered or dismissed" if kind == "question" else "granted or denied"
    return reply(
        {"error": "at-cap", "waiting": waiting},
        "skein: you already have %d waiting: %s. Ask again once one is %s. "
        "skein_requests lists them." % (CAP, ", ".join(waiting), frees),
    )


def requests(_args):
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return {"error": "no-box-name", "requests": []}
    fleet = os.environ.get("SKEIN_FLEET_ROOT") or "/boxes"
    answers = inbox_answers()
    out = []
    for kind, queue, fields in QUEUES:
        d = os.path.join(fleet, ".skein", queue, "requests", box)
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".json") or name.startswith("."):
                continue
            try:
                with open(os.path.join(d, name), encoding="utf-8") as f:
                    r = json.load(f)
            except (OSError, ValueError):
                continue
            if not isinstance(r, dict):
                continue
            rid = str(r.get("id") or name[: -len(".json")])
            row = {"queue": kind, "id": rid, "asked": str(r.get("asked", ""))}
            for field in fields:
                if field in r:
                    row[field] = r[field]
            # **Never `r["state"]`.** The box wrote this file and can write `granted` into it; the
            # only answer is one found in the inbox, which it cannot write.
            answer, decision, why = answer_for(kind, rid, answers)
            row["state"] = decision or "waiting"
            row["answer"] = answer
            if why is not None and kind == "question":
                row["answered"] = why
            elif why:
                row["why"] = why
            # A browser skein fetched is linked into every running box as it arrives (SKEIN-1355).
            # Where that did not reach this box, its agent can do the same itself, with the one
            # script the kit and skein run: it touches nothing of the box's own.
            if kind == "package" and r.get("kind") == "playwright" and decision == "installed":
                row["link"] = (
                    "The browser is in the fleet's store. If Playwright still says it is missing, "
                    "run: bash %s/.skein/skein-link-browsers.sh" % fleet
                )
            out.append(row)
    out.sort(key=lambda r: r["asked"])
    return {"box": box, "requests": out}


# ------------------------------------------------------------------------------------------------
# skein_request_package, skein_request_write, skein_ask_person
# ------------------------------------------------------------------------------------------------


class Reply(dict):
    """A tool's answer with a sentence for the agent after it, as the second content block."""

    def __init__(self, result, said):
        super().__init__(result)
        self.said = said


def reply(result, said):
    return Reply(result, said)


def launcher():
    """The launcher every box's shims call, where `fleet::box_session_path` installs it."""
    return os.path.join(os.environ.get("SKEIN_FLEET_ROOT") or "/boxes", ".skein", "box-session.sh")


def file_through_launcher(kind, queue, argv):
    """Run one of the launcher's two filing entry points, and say what it said.

    The launcher does the filing, so there is one path per queue: the same validation, the same
    collapse of a repeated ask, the same drop-box, and the same sentences the shims print. Its exit
    codes are its vocabulary: 0 filed (or already asked), 3 refused for the name, 4 not recorded.
    """
    box = os.environ.get("SKEIN_BOX", "")
    if not BOX_NAME.match(box) or ".." in box:
        return {"error": "no-box-name"}
    refused = at_cap(kind, queue)
    if refused is not None:
        return refused
    try:
        done = subprocess.run(
            ["bash", launcher()] + argv[:1] + [box] + argv[1:],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return {"error": "launcher-failed"}
    said = (done.stdout + done.stderr).strip()
    if done.returncode == 3:
        return reply({"error": "refused"}, said)
    if done.returncode != 0:
        return reply({"error": "not-recorded"}, said)
    m = re.search(r"[Rr]equest (\S+) is ", done.stdout)
    if not m:
        return reply({"error": "not-recorded"}, said)
    rid = m.group(1)
    _answer, decision, _why = answer_for(kind, rid, inbox_answers())
    return reply({"id": rid, "state": decision or "waiting"}, said)


def request_package(args):
    manager = args.get("manager")
    packages = args.get("packages")
    why = args.get("why")
    if manager not in ("apt", "npm", "playwright"):
        return {"error": "manager-must-be-apt-npm-or-playwright"}
    # Required, and one line: the owner reads it on the card as "why: <text>".
    if not isinstance(why, str) or not why.strip() or "\n" in why or "\r" in why:
        return {"error": "why-must-be-text"}
    if (
        not isinstance(packages, list)
        or not packages
        or not all(isinstance(p, str) and p and not p.startswith("-") for p in packages)
    ):
        return {"error": "packages-must-be-a-list-of-names"}
    tool = {"apt": "apt-get", "npm": "npm", "playwright": "playwright"}[manager]
    return file_through_launcher(
        "package", "substrate", ["--request-package", "--why", why.strip(), tool, "install"] + packages
    )


def request_write(args):
    repo = args.get("repo")
    why = args.get("why", "")
    if not isinstance(repo, str) or not repo:
        return {"error": "repo-must-be-owner/name"}
    if not isinstance(why, str):
        return {"error": "why-must-be-text"}
    return file_through_launcher("write", "gitgate", ["--request-write", repo] + ([why] if why else []))


def kb(n):
    """Bytes as the approved sentence prints them: KB, one decimal, rounded up so 2049 bytes is
    never "2.0 KB" beside a limit of 2 KB."""
    tenths = -(-n * 10 // 1024)
    return "%d.%d" % (tenths // 10, tenths % 10)


def ask_person(args):
    question = args.get("question")
    options = args.get("options", [])
    if not isinstance(question, str) or not question.strip():
        return {"error": "question-must-be-text"}
    if not isinstance(options, list) or not all(
        isinstance(o, str) and o.strip() and "\n" not in o and "\r" not in o for o in options
    ):
        return {"error": "options-must-be-one-line-each"}
    size = len(question.encode("utf-8")) + sum(len(o.encode("utf-8")) for o in options)
    if size > MAX_ASK_BYTES:
        return reply(
            {"error": "too-long", "bytes": size},
            "skein: a question is at most 2 KB and this one is %s KB. Shorten it and ask again." % kb(size),
        )
    d = own_queue("asks")
    if d is None:
        return {"error": "no-box-name"}
    refused = at_cap("question", "asks")
    if refused is not None:
        return refused
    # The launcher made this directory outside the box and bound it in; in a box it exists already.
    # Writability is asked, not assumed, for `request_package`'s reason: `makedirs` succeeds on a
    # neighbour's directory that exists and is read-only here.
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        pass
    if not os.access(d, os.W_OK):
        return {"error": "not-recorded", "queue": d}
    answers = inbox_answers()
    for _ in range(20):
        rid = "q-" + os.urandom(4).hex()
        if not os.path.exists(os.path.join(d, rid + ".json")) and answer_for("question", rid, answers)[0] is None:
            break
    else:
        return {"error": "not-recorded", "queue": d}
    body = {
        "id": rid,
        "box": os.environ.get("SKEIN_BOX", ""),
        "question": question,
        "options": options,
        "asked": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    tmp = os.path.join(d, ".tmp." + rid)
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(body, f)
        # Named only once complete: the cockpit reads this directory, and a half-written ask is a
        # parse error there rather than a question that arrives a moment later.
        os.replace(tmp, os.path.join(d, rid + ".json"))
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return {"error": "not-recorded", "queue": d}
    return reply(
        {"id": rid, "state": "waiting"},
        "skein: asked the person (question %s). The answer arrives in your inbox; nothing is answered yet." % rid,
    )


# ------------------------------------------------------------------------------------------------
# The protocol
# ------------------------------------------------------------------------------------------------

TOOLS = [
    {
        "name": "skein_resources",
        "description": "This box's resource signal file as skein wrote it: its disk, memory, "
        "throttle rate and process count against its limits, and anything skein asks of it.",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_top",
        "description": "This box's largest processes by memory or CPU, with each one's age and "
        "whether it has no parent. By disk: what this box is charged for, its download caches, "
        "build output and scratchpads by size, and its checkout's largest directories; and on a "
        "line of its own, the repo's shared download cache, which is not counted against this box.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "by": {"type": "string", "enum": ["memory", "cpu", "disk"]},
                "n": {"type": "integer", "minimum": 1, "maximum": TOP_MAX},
            },
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_clean",
        "description": "What in this box can be removed and made again: its download caches, build "
        "output and scratchpads, and the repo's shared download cache, each with its size and "
        "whether it is safe to remove now. Call it with no paths to see the list; pass paths from "
        "that list to remove them. Nothing else is removed, a link is never followed, and config "
        "and logins are never on the list.",
        "inputSchema": {
            "type": "object",
            "properties": {"paths": {"type": "array", "items": {"type": "string"}}},
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_requests",
        "description": "This box's own package and repository-write requests and questions, and "
        "the owner's answer to each, from the inbox only the owner can write. A filled browser "
        "request says how to link the browser into this box now.",
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
        "annotations": {"readOnlyHint": True, "openWorldHint": False},
    },
    {
        "name": "skein_request_package",
        "description": "Ask the fleet's owner to install a system package for every box. Nothing "
        "is installed until they approve it in the cockpit; the answer arrives in your inbox. "
        "For a Playwright browser the fleet lacks, use manager playwright and one package like "
        "chromium@1.56.1 (your Playwright version): skein fetches it for every box with no "
        "approval needed.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "manager": {"type": "string", "enum": ["apt", "npm", "playwright"]},
                "packages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
                "why": {"type": "string"},
            },
            "required": ["manager", "packages", "why"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
    {
        "name": "skein_request_write",
        "description": "Ask the fleet's owner for write access to a repository that is not this "
        "box's own (owner/name), and say why. The answer arrives in your inbox.",
        "inputSchema": {
            "type": "object",
            "properties": {"repo": {"type": "string"}, "why": {"type": "string"}},
            "required": ["repo", "why"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
    {
        "name": "skein_ask_person",
        "description": "Ask the fleet's owner a question, at most 2 KB, optionally with the answers "
        "to choose from. They see it in the cockpit as your own words; the answer arrives in your "
        "inbox. At most 5 may wait at once.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "question": {"type": "string"},
                "options": {"type": "array", "items": {"type": "string"}},
            },
            "required": ["question"],
            "additionalProperties": False,
        },
        "annotations": {"readOnlyHint": False, "destructiveHint": False, "openWorldHint": False},
    },
]

HANDLERS = {
    "skein_resources": resources,
    "skein_top": top,
    "skein_clean": clean,
    "skein_requests": requests,
    "skein_request_package": request_package,
    "skein_request_write": request_write,
    "skein_ask_person": ask_person,
}


def call(params):
    name = params.get("name")
    args = params.get("arguments") or {}
    handler = HANDLERS.get(name)
    if handler is None or not isinstance(args, dict):
        return {"content": [{"type": "text", "text": json.dumps({"error": "unknown-tool"})}], "isError": True}
    result = handler(args)
    content = [{"type": "text", "text": json.dumps(dict(result), indent=1)}]
    said = getattr(result, "said", "")
    if said:
        content.append({"type": "text", "text": said})
    return {"content": content, "isError": "error" in result}


def answer(msg):
    """The response to one message, or None for a notification."""
    method = msg.get("method")
    mid = msg.get("id")
    if mid is None:
        return None
    params = msg.get("params") or {}
    if method == "initialize":
        result = {
            "protocolVersion": params.get("protocolVersion") or PROTOCOL,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "skein", "version": "0.1.0"},
        }
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        result = call(params)
    elif method == "ping":
        result = {}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "method not found"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def run_once(argv):
    """`skein-mcp clean [PATH...]` and `skein-mcp requests`: the same `skein_clean` and
    `skein_requests` without the protocol, for callers that are not an MCP client (the mod skein's
    plugin is becoming, SKEIN-1358; its compaction keeper reads `requests`, SKEIN-1364). Prints the
    result and the sentence for the agent as one JSON object; exits 1 when the result is an error."""
    if argv[:1] == ["clean"]:
        result = clean({"paths": argv[1:]})
    elif argv == ["requests"]:
        result = requests({})
    else:
        sys.stderr.write("usage: skein-mcp clean [PATH...] | skein-mcp requests\n")
        return 2
    sys.stdout.write(json.dumps({"result": dict(result), "said": getattr(result, "said", "")}) + "\n")
    return 1 if "error" in result else 0


def main():
    if len(sys.argv) > 1:
        sys.exit(run_once(sys.argv[1:]))
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            reply = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            if not isinstance(msg, dict):
                continue
            try:
                reply = answer(msg)
            except Exception:  # noqa: BLE001 - one bad call must not end the server
                reply = {
                    "jsonrpc": "2.0",
                    "id": msg.get("id"),
                    "error": {"code": -32603, "message": "internal error"},
                }
        if reply is not None:
            sys.stdout.write(json.dumps(reply) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
